[Unit]
Description=Camera Monitor
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/opt/cameramonitor
EnvironmentFile=/etc/cameramonitor.env
# ONE worker only: the ping/alert thread starts with the app, so more workers = duplicate alerts.
ExecStart=/opt/cameramonitor/venv/bin/gunicorn -w 1 --threads 4 -b 127.0.0.1:5000 app:app
Restart=always

[Install]
WantedBy=multi-user.target
